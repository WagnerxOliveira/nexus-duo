{
  "$schema": "https://nexusduo.app/schemas/design-tokens.v1.json",
  "meta": {
    "name": "NEXUS DUO Design Tokens",
    "theme": "Cyber-Velvet & Obsidian Neon",
    "version": "1.0.0",
    "typeScaleRatio": 1.2
  },
  "colors": {
    "bg": {
      "void": "#080A0F",
      "surface": "#111521",
      "elevated": "#191F31"
    },
    "border": {
      "subtle": "rgba(255, 255, 255, 0.08)",
      "glow": "rgba(139, 92, 246, 0.45)"
    },
    "brand": {
      "primary": "#8B5CF6",
      "secondary": "#EC4899"
    },
    "accent": {
      "cyber": "#06B6D4"
    },
    "semantic": {
      "success": "#10B981",
      "warning": "#F59E0B",
      "danger": "#EF4444"
    },
    "text": {
      "primary": "#F8FAFC",
      "secondary": "#94A3B8",
      "muted": "#64748B"
    }
  },
  "gradients": {
    "brandGradient": {
      "angleDeg": 135,
      "stops": [
        { "color": "#8B5CF6", "position": 0.0 },
        { "color": "#EC4899", "position": 1.0 }
      ],
      "css": "linear-gradient(135deg, #8B5CF6 0%, #EC4899 100%)"
    },
    "scrimCard": {
      "angleDeg": 0,
      "stops": [
        { "color": "rgba(8, 10, 15, 0.95)", "position": 0.0 },
        { "color": "rgba(8, 10, 15, 0.55)", "position": 0.45 },
        { "color": "rgba(8, 10, 15, 0.0)", "position": 1.0 }
      ],
      "css": "linear-gradient(to top, rgba(8, 10, 15, 0.95) 0%, rgba(8, 10, 15, 0.55) 45%, transparent 100%)"
    },
    "cyberAura": {
      "angleDeg": 135,
      "stops": [
        { "color": "rgba(139, 92, 246, 0.22)", "position": 0.0 },
        { "color": "rgba(6, 182, 212, 0.16)", "position": 0.5 },
        { "color": "rgba(236, 72, 153, 0.14)", "position": 1.0 }
      ],
      "css": "linear-gradient(135deg, rgba(139, 92, 246, 0.22) 0%, rgba(6, 182, 212, 0.16) 50%, rgba(236, 72, 153, 0.14) 100%)"
    }
  },
  "typography": {
    "families": {
      "display": "Space Grotesk",
      "body": "Plus Jakarta Sans",
      "mono": "JetBrains Mono"
    },
    "scaleRatio": 1.2,
    "roles": {
      "displayXl": {
        "fontFamily": "display",
        "sizeMobilePx": 32,
        "sizeWebPx": 44,
        "lineHeight": 1.15,
        "fontWeight": 700,
        "letterSpacingEm": -0.03
      },
      "headingLg": {
        "fontFamily": "display",
        "sizeMobilePx": 24,
        "sizeWebPx": 24,
        "lineHeight": 1.2,
        "fontWeight": 700,
        "letterSpacingEm": -0.02
      },
      "headingMd": {
        "fontFamily": "display",
        "sizeMobilePx": 18,
        "sizeWebPx": 18,
        "lineHeight": 1.3,
        "fontWeight": 600,
        "letterSpacingEm": -0.01
      },
      "bodyLg": {
        "fontFamily": "body",
        "sizeMobilePx": 16,
        "sizeWebPx": 16,
        "lineHeight": 1.5,
        "fontWeight": 400,
        "letterSpacingEm": 0.0
      },
      "bodyMd": {
        "fontFamily": "body",
        "sizeMobilePx": 14,
        "sizeWebPx": 14,
        "lineHeight": 1.45,
        "fontWeight": 500,
        "letterSpacingEm": 0.0
      },
      "labelSm": {
        "fontFamily": "body",
        "sizeMobilePx": 12,
        "sizeWebPx": 12,
        "lineHeight": 1.3,
        "fontWeight": 600,
        "letterSpacingEm": 0.04
      },
      "monoStat": {
        "fontFamily": "mono",
        "sizeMobilePx": 14,
        "sizeWebPx": 20,
        "lineHeight": 1.1,
        "fontWeight": 700,
        "letterSpacingEm": -0.02
      }
    }
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "pageCompact": 16,
    "pageStandard": 20,
    "pageDesktop": 32
  },
  "radii": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 9999
  },
  "shadows": {
    "card": {
      "color": "rgba(0, 0, 0, 0.45)",
      "offsetX": 0,
      "offsetY": 16,
      "blur": 40,
      "spread": -8,
      "css": "0 16px 40px -8px rgba(0, 0, 0, 0.45)"
    },
    "glowPrimary": {
      "color": "rgba(139, 92, 246, 0.35)",
      "offsetX": 0,
      "offsetY": 0,
      "blur": 24,
      "spread": 0,
      "css": "0 0 24px rgba(139, 92, 246, 0.35)"
    },
    "glowCyber": {
      "color": "rgba(6, 182, 212, 0.30)",
      "offsetX": 0,
      "offsetY": 0,
      "blur": 20,
      "spread": 0,
      "css": "0 0 20px rgba(6, 182, 212, 0.30)"
    },
    "glowMatch": {
      "color": "rgba(236, 72, 153, 0.38)",
      "offsetX": 0,
      "offsetY": 0,
      "blur": 28,
      "spread": 0,
      "css": "0 0 28px rgba(236, 72, 153, 0.38)"
    }
  },
  "breakpoints": {
    "mobileCompactMax": 380,
    "tabletMin": 600,
    "desktopMin": 1024,
    "ultrawideMin": 1440
  }
}
