# =============================================================================
# NEXUS DUO — Supabase Local & Edge Functions Environment Template
# Copy to supabase/.env (NEVER commit real secrets!)
# =============================================================================

# --- Supabase Core (injected automatically in Supabase Cloud) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-service-role-key-never-expose-to-clients

# --- Discord OAuth2 (Supabase Auth External Provider) ---
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=replace-with-discord-client-id
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=replace-with-discord-client-secret

# --- IGDB / Twitch OAuth2 (Primary Game Catalog API — Free Tier) ---
TWITCH_CLIENT_ID=replace-with-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-twitch-client-secret

# --- RAWG API (Fallback Game Catalog API — Free Tier 20k req/month) ---
RAWG_API_KEY=replace-with-rawg-api-key

# --- Steam Web API (Optional Library Sync — Free Tier) ---
STEAM_API_KEY=replace-with-steam-web-api-key

# --- Edge Functions CORS Allowlist (comma-separated origins) ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nexusduo.app
